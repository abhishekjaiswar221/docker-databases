# Copy to .env to override defaults. Values below equal built-in defaults.
# Changing credentials after first start has no effect until data/<db> is deleted.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=devdb
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_PORT=3306

POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb
POSTGRES_PORT=5432

MONGO_USER=root
MONGO_PASSWORD=root
MONGO_PORT=27017

REDIS_PORT=6379
